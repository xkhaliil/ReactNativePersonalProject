# ─── Spotify ──────────────────────────────────────────────────────────────────
#
# Required to enable real Spotify track recommendations and OAuth login.
#
# Steps:
#   1. Go to https://developer.spotify.com/dashboard
#   2. Create a new app (or open an existing one)
#   3. Copy the Client ID below
#   4. Under "Redirect URIs", add both:
#        skycast://spotify-auth          ← production / EAS builds
#        exp://localhost:8081            ← Expo Go (local dev)
#      (the port may differ — check the Expo Dev Tools URL)
#
# The Client Secret is NOT needed — this app uses PKCE, which is safe
# for mobile apps and does not require a server-side secret.
#
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# ─── Face detection ───────────────────────────────────────────────────────────
#
# Mood detection is now 100% ON-DEVICE using expo-face-detector.
# No API key is required for facial recognition.
# Google ML Kit (Android) and Apple Vision (iOS) run entirely on the device.
#
