{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "types": ["jest", "node"],
    "paths": {
      "#app": ["./src/app/index.ts"],
      "#app/*": ["./src/app/*"],
      "#features/*": ["./src/features/*"],
      "#shared": ["./src/shared/index.ts"],
      "#shared/*": ["./src/shared/*"]
    }
  }
}
